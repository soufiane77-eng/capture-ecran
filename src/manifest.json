{
  "manifest_version": 3,
  "name": "Capture Écran",
  "version": "1.0.0",
  "description": "Sélectionnez une zone de la page : elle est capturée en PNG et copiée automatiquement dans le presse-papiers.",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capturer une zone et la copier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
